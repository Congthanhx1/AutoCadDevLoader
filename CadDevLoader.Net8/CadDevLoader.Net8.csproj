<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CadDevLoader.Net8</AssemblyName>
    <RootNamespace>CadDevLoader</RootNamespace>
    <AutoCADDir Condition="'$(AutoCADDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2026</AutoCADDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\DevLoaderCommands.cs" Link="DevLoaderCommands.cs" />
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCADDir)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCADDir)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCADDir)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateAutoCADReferences" BeforeTargets="ResolveReferences">
    <Error
      Condition="!Exists('$(AutoCADDir)\AcCoreMgd.dll')"
      Text="AutoCAD API not found. Build with -p:AutoCADDir=&quot;C:\Program Files\Autodesk\AutoCAD 2026&quot;." />
  </Target>
</Project>
